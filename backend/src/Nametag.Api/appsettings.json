{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=nametag;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "nametag-api",
    "Audience": "nametag-app",
    "KeyId": "nametag-key-1",
    "AccessTokenLifetimeMinutes": 15
  },
  "AllowedHosts": "*"
}
